<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BlazeUma.Memory\BlazeUma.Memory.csproj" />
    <ProjectReference Include="..\BlazeUma.Data\BlazeUma.Data.csproj" />
    <ProjectReference Include="..\BlazeUma.Advisor\BlazeUma.Advisor.csproj" />
    <ProjectReference Include="..\BlazeUma.Automation\BlazeUma.Automation.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>BlazeUma</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- `dotnet publish -c Release`: one BlazeUma.exe that runs without .NET installed. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
  </PropertyGroup>

  <!-- The in-game agent ships beside the exe (build it first with cmake, see agent/). -->
  <ItemGroup>
    <None Include="..\..\agent\build\Release\BlazeUma.Agent.dll" Condition="Exists('..\..\agent\build\Release\BlazeUma.Agent.dll')"
          Link="BlazeUma.Agent.dll" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
