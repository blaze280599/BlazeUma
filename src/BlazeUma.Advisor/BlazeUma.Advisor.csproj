<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BlazeUma.Data\BlazeUma.Data.csproj" />
    <ProjectReference Include="..\BlazeUma.Memory\BlazeUma.Memory.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Event outcome counts learned from career logs (EventOdds), beside the exe; rebuild with `BlazeUma event-odds`. -->
  <ItemGroup>
    <None Include="..\..\data\event-odds.json" Link="data\event-odds.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
